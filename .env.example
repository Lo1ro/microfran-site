# Copie este arquivo para `.env` e preencha o que for usar.
# Nada aqui é obrigatório — sem essas variáveis o site funciona com os dados de exemplo/fallback.

# ── Catálogo via Google Sheets (opcional) ────────────────────────────────────
# Publique a planilha como CSV (Arquivo → Compartilhar → Publicar na web → CSV)
# e cole o link aqui. Sem isso, o site usa src/data/products.json.
CATALOG_CSV_URL=

# ── Preços vindos do sistema da loja (opcional, recomendado) ────────────────
# Com isto, o PREÇO do site vem do PDV (casando pelo código de barras da coluna
# "codigo" da planilha) em vez da planilha. O dono mexe no preço num lugar só.
# Sem isto, vale o preço da coluna "preco".
# Use a chave PUBLISHABLE (nunca a secret/service_role).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Avaliações do Google (opcional) ──────────────────────────────────────────
# Com chave + Place ID, a nota e o total de avaliações são puxados do Google
# a cada build. Sem isso, usa o fallback definido em src/config.ts (4,4★ · 35).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Google Analytics 4 (opcional) ────────────────────────────────────────────
# Ex.: G-XXXXXXXXXX
PUBLIC_GA4_ID=
