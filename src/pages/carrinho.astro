---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CartView from '../components/islands/CartView';
---

<BaseLayout title="Carrinho" noIndex>
  <section class="mx-auto max-w-6xl px-4 py-10 pb-24 lg:py-14">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-display text-4xl font-extrabold sm:text-5xl">Seu carrinho</h1>
        <p class="mt-3 text-lg text-ink-soft">
          Revise o pedido e finalize no WhatsApp — pagamento e retirada você combina com a loja.
        </p>
      </div>
      <a href="/catalogo" class="btn btn-ghost btn-sm">
        <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
        Continuar comprando
      </a>
    </div>

    <div class="mt-10">
      <CartView client:only="preact" />
    </div>
  </section>
</BaseLayout>
