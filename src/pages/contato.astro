---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, mapsComoChegar, mapsEmbed } from '../config';
import { waPadrao } from '../lib/whatsapp';

const e = SITE.endereco;
---

<BaseLayout
  title="Contato"
  description={`Fale com a Micro Fran em Jeriquara/SP: WhatsApp ${SITE.whatsappDisplay}, ${e.rua} — ${e.bairro}. ${SITE.horario.resumo}.`}
>
  <section class="mx-auto max-w-6xl px-4 py-10 lg:py-14">
    <h1 class="font-display text-4xl font-extrabold sm:text-5xl">Contato</h1>
    <p class="mt-3 max-w-xl text-lg text-ink-soft">
      O caminho mais rápido é o WhatsApp — mas a porta da loja está sempre aberta.
    </p>

    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      <a
        href={waPadrao()}
        target="_blank"
        rel="noopener"
        class="card group flex items-center gap-5 p-6 transition-transform hover:-translate-y-1 sm:col-span-2 lg:col-span-1"
      >
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-wa text-wa-ink">
          <Icon name="whatsapp" class="h-7 w-7" stroke={1.6} />
        </span>
        <span>
          <span class="block font-display text-xl font-extrabold">WhatsApp</span>
          <span class="block text-ink-soft">{SITE.whatsappDisplay}</span>
          <span class="mt-1 inline-flex items-center gap-1 text-sm font-bold text-brand-deep">
            Chamar agora
            <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </span>
        </span>
      </a>

      <div class="card flex items-center gap-5 p-6">
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-brand-soft text-brand-deep">
          <Icon name="clock" class="h-7 w-7" />
        </span>
        <span>
          <span class="block font-display text-xl font-extrabold">Horário</span>
          <span class="block text-ink-soft">{SITE.horario.resumo}</span>
          <span class="block text-sm text-ink-soft/80">{SITE.horario.observacao}</span>
        </span>
      </div>

      <div class="card flex items-center gap-5 p-6">
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-brand-soft text-brand-deep">
          <Icon name="map-pin" class="h-7 w-7" />
        </span>
        <span>
          <span class="block font-display text-xl font-extrabold">Endereço</span>
          <span class="block text-ink-soft">
            {e.rua} — {e.bairro}<br />
            {e.cidade}/{e.uf} · CEP {e.cep}
          </span>
          <a
            href={mapsComoChegar()}
            target="_blank"
            rel="noopener"
            class="mt-1 inline-flex items-center gap-1 text-sm font-bold text-brand-deep hover:underline"
          >
            Como chegar
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </span>
      </div>

      <div class="card flex items-center gap-5 p-6">
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-brand-soft text-brand-deep">
          <Icon name="heart" class="h-7 w-7" />
        </span>
        <span>
          <span class="block font-display text-xl font-extrabold">Redes sociais</span>
          <span class="block text-ink-soft">Acompanhe as novidades da loja</span>
          <span class="mt-2 flex gap-2">
            <a
              href={SITE.redes.instagram}
              target="_blank"
              rel="noopener"
              aria-label="Instagram da Micro Fran"
              class="grid h-9 w-9 place-items-center rounded-full border-[1.5px] border-line transition hover:border-brand hover:text-brand-deep"
            >
              <Icon name="instagram" class="h-4 w-4" />
            </a>
            <a
              href={SITE.redes.facebook}
              target="_blank"
              rel="noopener"
              aria-label="Facebook da Micro Fran"
              class="grid h-9 w-9 place-items-center rounded-full border-[1.5px] border-line transition hover:border-brand hover:text-brand-deep"
            >
              <Icon name="facebook" class="h-4 w-4" />
            </a>
          </span>
        </span>
      </div>
    </div>

    <div class="card mt-4 overflow-hidden p-2">
      <iframe
        src={mapsEmbed()}
        title="Mapa: como chegar na Micro Fran, em Jeriquara/SP"
        width="100%"
        height="380"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
        class="rounded-2xl"
      ></iframe>
    </div>
  </section>
</BaseLayout>
