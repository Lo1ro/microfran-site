---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { SITE } from '../config';
import { getGoogleRating } from '../lib/rating';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}
const { title, description = SITE.descricao, noIndex = false } = Astro.props;

const tituloCompleto = title
  ? `${title} — ${SITE.nome}`
  : `${SITE.nome} — Papelaria, Informática e Gráfica em Jeriquara/SP`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/og.png', SITE.url).href;
const ga4 = (import.meta.env.PUBLIC_GA4_ID as string | undefined) ?? '';

const rating = await getGoogleRating();
const e = SITE.endereco;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: SITE.nome,
  description: SITE.descricao,
  url: SITE.url,
  image: ogImage,
  telephone: `+${SITE.whatsapp}`,
  priceRange: '$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${e.rua} — ${e.bairro}`,
    addressLocality: e.cidade,
    addressRegion: e.uf,
    postalCode: e.cep,
    addressCountry: 'BR',
  },
  sameAs: [SITE.redes.instagram, SITE.redes.facebook],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: rating.nota,
    reviewCount: rating.total,
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- marca que há JS antes de pintar: só então o reveal esconde o conteúdo -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf6ef" />
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {ga4 && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />}
    {
      ga4 && (
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', ga4);
        </script>
      )
    }
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script>
      // Reveal escalonado ao rolar — leve e com fallback
      const alvos = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('is-visible');
                io.unobserve(entrada.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        alvos.forEach((el) => io.observe(el));
      } else {
        alvos.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
