---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import CartIndicator from './islands/CartIndicator';
import { waPadrao } from '../lib/whatsapp';

const links = [
  { href: '/catalogo', rotulo: 'Catálogo' },
  { href: '/solucoes-graficas', rotulo: 'Soluções Gráficas' },
  { href: '/sobre', rotulo: 'Sobre' },
  { href: '/contato', rotulo: 'Contato' },
];
const caminho = Astro.url.pathname.replace(/\/$/, '') || '/';
const ativo = (href: string) => caminho === href || caminho.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4">
    <a href="/" class="shrink-0" aria-label="Micro Fran — página inicial">
      <Logo class="h-10" />
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="Navegação principal">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={ativo(l.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-3.5 py-2 text-sm font-bold transition-colors',
            ativo(l.href)
              ? 'bg-brand-soft text-brand-deep'
              : 'text-ink hover:bg-surface hover:text-brand-deep',
          ]}
        >
          {l.rotulo}
        </a>
      ))}
    </nav>

    <a
      href="/carrinho"
      class="relative ml-auto grid h-11 w-11 place-items-center rounded-full border-[1.5px] border-line bg-surface transition hover:border-brand hover:text-brand-deep md:ml-2"
      aria-label="Ver carrinho"
    >
      <Icon name="cart" class="h-5 w-5" />
      <CartIndicator client:load />
    </a>

    <button
      id="btn-menu"
      type="button"
      class="grid h-11 w-11 place-items-center rounded-full border-[1.5px] border-line bg-surface md:hidden"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Abrir menu"
    >
      <span id="icone-abrir"><Icon name="menu" class="h-5 w-5" /></span>
      <span id="icone-fechar" hidden><Icon name="x" class="h-5 w-5" /></span>
    </button>
  </div>

  <nav id="menu-mobile" hidden class="border-t border-line bg-paper px-4 pb-5 pt-2 md:hidden" aria-label="Menu">
    {links.map((l) => (
      <a
        href={l.href}
        aria-current={ativo(l.href) ? 'page' : undefined}
        class:list={[
          'block rounded-xl px-3 py-3 text-base font-bold',
          ativo(l.href) ? 'bg-brand-soft text-brand-deep' : 'text-ink',
        ]}
      >
        {l.rotulo}
      </a>
    ))}
    <a href={waPadrao()} target="_blank" rel="noopener" class="btn btn-wa mt-3 w-full">
      <Icon name="whatsapp" class="h-5 w-5" stroke={1.6} />
      Chamar no WhatsApp
    </a>
  </nav>
</header>

<script>
  const botao = document.getElementById('btn-menu');
  const menu = document.getElementById('menu-mobile');
  const abrir = document.getElementById('icone-abrir');
  const fechar = document.getElementById('icone-fechar');

  botao?.addEventListener('click', () => {
    const vaiAbrir = menu?.hasAttribute('hidden') ?? false;
    menu?.toggleAttribute('hidden', !vaiAbrir);
    abrir?.toggleAttribute('hidden', vaiAbrir);
    fechar?.toggleAttribute('hidden', !vaiAbrir);
    botao.setAttribute('aria-expanded', String(vaiAbrir));
    botao.setAttribute('aria-label', vaiAbrir ? 'Fechar menu' : 'Abrir menu');
  });
</script>
